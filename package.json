{
  "name": "rocksoul-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "ci": "pnpm run validate:contract && pnpm run audit:ui-hero && pnpm run audit:aws-surface && pnpm run typecheck && pnpm run build",
    "validate:contract": "node scripts/validate-rocksoul-contract.mjs",
    "audit:ui-hero": "node scripts/ui-hero-audit.mjs",
    "audit:aws-surface": "node scripts/aws-surface-audit.mjs"
  },
  "dependencies": {
    "@rocksoul/ui": "github:bjo163/rocksoul-ui#6a98ce0d5f5be60d4744f073837cd754639ea044",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.3",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.5.2"
}
